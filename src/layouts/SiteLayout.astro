---
import '../styles/archive.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'Chemistry Archive | Study Hub',
  description = 'Search Chemistry notes and exam practice resources in the Study Hub archive.',
  canonical = 'https://trustjonathan.github.io/CHEMISTRY/archive.html'
} = Astro.props;
const base = `${import.meta.env.BASE_URL}/`;
const siteRoot = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f6f0" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://trustjonathan.github.io/CHEMISTRY/chemistry.jpg" />
    <meta property="og:type" content="website" />
    <link rel="icon" href={`${base}logo.png`} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header" id="top">
      <div class="utility-bar">
        <div class="utility-inner">
          <nav class="utility-links" aria-label="Utility navigation">
            <a href="https://trustjonathan.github.io/STUDY-HUB/frontend/src/html/about.html">About</a>
            <a href="mailto:trusteth777@gmail.com">Contact</a>
          </nav>
          <span class="utility-note">Made for Ugandan learners</span>
        </div>
      </div>
      <div class="header-main">
        <nav class="site-nav" aria-label="Chemistry archive navigation">
          <a href="https://trustjonathan.github.io/STUDY-HUB/">Home</a>
          <a href={`${siteRoot}#overview`}>Overview</a>
          <a href={`${siteRoot}#archive`} aria-current="page">Archive</a>
        </nav>
        <a class="brand" href="https://trustjonathan.github.io/STUDY-HUB/" aria-label="Study Hub home">
          <img src={`${base}logo.png`} width="38" height="38" alt="" />
          <span>Study Hub</span>
        </a>
        <nav class="header-actions" aria-label="Archive actions">
          <a href={`${siteRoot}#archive`}>Search archive</a>
          <a href="mailto:trusteth777@gmail.com?subject=Chemistry%20resource%20request">Request resource</a>
        </nav>
      </div>
      <nav class="mega-nav" aria-label="Study Hub links">
        <section class="mega-nav-group">
          <h2>Study Hub</h2>
          <a href="https://trustjonathan.github.io/STUDY-HUB/">Home</a>
        </section>
        <section class="mega-nav-group">
          <h2>Biology</h2>
          <a href="https://trustjonathan.github.io/BIOLOGY/archive.html">Biology archive</a>
        </section>
        <section class="mega-nav-group">
          <h2>Chemistry</h2>
          <a href={siteRoot}>Chemistry archive</a>
        </section>
        <section class="mega-nav-group">
          <h2>Mathematics</h2>
          <a href="https://trustjonathan.github.io/MATHEMATICS/archive.html">Mathematics archive</a>
        </section>
        <section class="mega-nav-group">
          <h2>Support</h2>
          <a href="mailto:trusteth777@gmail.com?subject=Chemistry%20resource%20request">Request a resource</a>
        </section>
      </nav>
    </header>
    <slot />
    <footer class="site-footer" id="footer-links">
      <div class="footer-group">
        <h3>Study Hub</h3>
        <a href="https://trustjonathan.github.io/STUDY-HUB/">Home</a>
        <a href={`${siteRoot}#overview`}>Overview</a>
        <a href={`${siteRoot}#normal-pages`}>Normal pages</a>
      </div>
      <div class="footer-group">
        <h3>Subjects</h3>
        <a href="https://trustjonathan.github.io/BIOLOGY/">Biology</a>
        <a href="https://trustjonathan.github.io/STUDY-HUB/frontend/src/html/chemistry.html">Chemistry</a>
        <a href="https://trustjonathan.github.io/MATHEMATICS/archive.html">Mathematics</a>
      </div>
      <div class="footer-group">
        <h3>Archives</h3>
        <a href="https://trustjonathan.github.io/BIOLOGY/archive.html">Biology archive</a>
        <a href={siteRoot}>Chemistry archive</a>
        <a href="https://trustjonathan.github.io/MATHEMATICS/archive.html">Mathematics archive</a>
      </div>
      <div class="footer-brand">
        <a class="brand" href={siteRoot}>
          <img src={`${base}logo.png`} width="32" height="32" alt="" />
          <span>Study Hub / Chemistry</span>
        </a>
        <p>Free Chemistry study resources for focused revision.</p>
        <a class="back-to-top" href="#top">Back to top <span aria-hidden="true">↑</span></a>
      </div>
    </footer>
  </body>
</html>
