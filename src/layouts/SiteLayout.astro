---
import '../styles/archive.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'Chemistry Archive | Study Hub',
  description = 'Search Chemistry notes and exam practice resources in the Study Hub archive.',
  canonical = 'https://trustjonathan.github.io/CHEMISTRY/archive.html'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f6f0" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://trustjonathan.github.io/STUDY-HUB/social-preview.png" />
    <meta property="og:image:secure_url" content="https://trustjonathan.github.io/STUDY-HUB/social-preview.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Study Hub connects Biology, Chemistry, and Mathematics notes with exam practice." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Study Hub" />
    <meta property="og:locale" content="en_UG" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://trustjonathan.github.io/STUDY-HUB/social-preview.png" />
    <meta name="twitter:image:alt" content="Study Hub connects Biology, Chemistry, and Mathematics notes with exam practice." />
    <link rel="icon" type="image/svg+xml" href="https://trustjonathan.github.io/STUDY-HUB/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="https://trustjonathan.github.io/STUDY-HUB/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://trustjonathan.github.io/STUDY-HUB/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header" id="top">
      <div class="utility-bar">
        <div class="utility-inner">
          <nav class="utility-links" aria-label="Utility navigation">
            <a href="https://trustjonathan.github.io/STUDY-HUB/frontend/src/html/about.html">About</a>
            <a href="mailto:trusteth777@gmail.com">Contact</a>
          </nav>
          <span class="utility-note">Made for Ugandan learners</span>
        </div>
      </div>
      <div class="header-main">
        <nav class="site-nav" aria-label="Chemistry archive navigation">
          <a href="https://trustjonathan.github.io/STUDY-HUB/">Home</a>
          <a href="#overview">Overview</a>
          <a href="#archive" aria-current="page">Archive</a>
        </nav>
        <a class="brand" href="https://trustjonathan.github.io/STUDY-HUB/" aria-label="Study Hub home">
          <img src="https://trustjonathan.github.io/STUDY-HUB/favicon.svg" width="38" height="38" alt="" />
          <span>Study Hub</span>
        </a>
        <nav class="header-actions" aria-label="Archive actions">
          <a href="#archive">Search archive</a>
          <a href="mailto:trusteth777@gmail.com?subject=Chemistry%20resource%20request">Request resource</a>
        </nav>
      </div>
      <nav class="mega-nav" aria-label="Study Hub links">
        <details class="mega-nav-group">
          <summary>Study Hub</summary>
          <div class="mega-nav-panel"><a href="https://trustjonathan.github.io/STUDY-HUB/">Home</a></div>
        </details>
        <details class="mega-nav-group">
          <summary>Biology</summary>
          <div class="mega-nav-panel">
            <a href="https://trustjonathan.github.io/STUDY-HUB/frontend/src/html/biology.html">Biology study hub</a>
            <a href="https://trustjonathan.github.io/BIOLOGY/archive.html">Biology archive</a>
          </div>
        </details>
        <details class="mega-nav-group">
          <summary>Chemistry</summary>
          <div class="mega-nav-panel">
            <a href="https://trustjonathan.github.io/STUDY-HUB/frontend/src/html/chemistry.html">Chemistry study hub</a>
            <a href="https://trustjonathan.github.io/CHEMISTRY/archive.html">Chemistry archive</a>
          </div>
        </details>
        <details class="mega-nav-group">
          <summary>Mathematics</summary>
          <div class="mega-nav-panel">
            <a href="https://trustjonathan.github.io/STUDY-HUB/frontend/src/html/mathematics.html">Mathematics study hub</a>
            <a href="https://trustjonathan.github.io/MATHEMATICS/archive.html">Mathematics archive</a>
          </div>
        </details>
        <details class="mega-nav-group">
          <summary>Support</summary>
          <div class="mega-nav-panel"><a href="mailto:trusteth777@gmail.com?subject=Chemistry%20resource%20request">Request a resource</a></div>
        </details>
      </nav>
    </header>
    <slot />
    <footer class="site-footer" id="footer-links">
      <div class="footer-group">
        <h3>Study Hub</h3>
        <a href="https://trustjonathan.github.io/STUDY-HUB/">Home</a>
        <a href="#overview">Overview</a>
        <a href="#normal-pages">Normal pages</a>
      </div>
      <div class="footer-group">
        <h3>Subjects</h3>
        <a href="https://trustjonathan.github.io/STUDY-HUB/frontend/src/html/biology.html">Biology</a>
        <a href="https://trustjonathan.github.io/STUDY-HUB/frontend/src/html/chemistry.html">Chemistry</a>
        <a href="https://trustjonathan.github.io/STUDY-HUB/frontend/src/html/mathematics.html">Mathematics</a>
      </div>
      <div class="footer-group">
        <h3>Archives</h3>
        <a href="https://trustjonathan.github.io/BIOLOGY/archive.html">Biology archive</a>
        <a href="https://trustjonathan.github.io/CHEMISTRY/archive.html">Chemistry archive</a>
        <a href="https://trustjonathan.github.io/MATHEMATICS/archive.html">Mathematics archive</a>
      </div>
      <div class="footer-brand">
        <a class="brand" href="https://trustjonathan.github.io/CHEMISTRY/archive.html">
          <img src="https://trustjonathan.github.io/STUDY-HUB/favicon.svg" width="32" height="32" alt="" />
          <span>Study Hub / Chemistry</span>
        </a>
        <p>Free Chemistry study resources for focused revision.</p>
        <a class="back-to-top" href="#top">Back to top <span aria-hidden="true">↑</span></a>
      </div>
    </footer>
    <script>
      const desktopHover = window.matchMedia('(hover: hover) and (min-width: 761px)');
      document.querySelectorAll<HTMLDetailsElement>('.mega-nav-group').forEach((group) => {
        group.addEventListener('pointerenter', () => {
          if (desktopHover.matches) group.open = true;
        });
        group.addEventListener('pointerleave', () => {
          if (desktopHover.matches && !group.contains(document.activeElement)) group.open = false;
        });
        group.addEventListener('focusin', () => {
          if (desktopHover.matches) group.open = true;
        });
        group.addEventListener('focusout', (event) => {
          const nextTarget = event.relatedTarget;
          if (desktopHover.matches && !(nextTarget instanceof Node && group.contains(nextTarget)) && !group.matches(':hover')) {
            group.open = false;
          }
        });
      });
    </script>
  </body>
</html>
