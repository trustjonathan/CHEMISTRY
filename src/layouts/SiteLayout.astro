---
import '../styles/archive.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'Chemistry Archive | Study Hub',
  description = 'Search Chemistry notes and exam practice resources in the Study Hub archive.',
  canonical = 'https://trustjonathan.github.io/CHEMISTRY/'
} = Astro.props;
const base = `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f6f0" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://trustjonathan.github.io/CHEMISTRY/chemistry.jpg" />
    <meta property="og:type" content="website" />
    <link rel="icon" href={`${base}logo.png`} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header" id="top">
      <a class="brand" href="https://trustjonathan.github.io/STUDY-HUB/" aria-label="Study Hub home">
        <img src={`${base}logo.png`} width="38" height="38" alt="" />
        <span>Study Hub</span>
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href="https://trustjonathan.github.io/STUDY-HUB/">Home</a>
        <a href={`${base}#overview`}>Overview</a>
        <a href={`${base}#archive`} aria-current="page">Archive</a>
        <a href="https://trustjonathan.github.io/BIOLOGY/archive.html">Biology archive</a>
        <a href="https://trustjonathan.github.io/CHEMISTRY/archive.html">Chemistry archive</a>
        <a href="https://trustjonathan.github.io/MATHEMATICS/archive.html">Mathematics archive</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer" id="footer-links">
      <div class="footer-group">
        <h3>Study Hub</h3>
        <a href="https://trustjonathan.github.io/STUDY-HUB/">Home</a>
        <a href={`${base}#overview`}>Overview</a>
        <a href={`${base}#normal-pages`}>Normal pages</a>
      </div>
      <div class="footer-group">
        <h3>Subjects</h3>
        <a href="https://trustjonathan.github.io/BIOLOGY/">Biology</a>
        <a href="https://trustjonathan.github.io/CHEMISTRY/">Chemistry</a>
        <a href="https://trustjonathan.github.io/MATHEMATICS/archive.html">Mathematics</a>
      </div>
      <div class="footer-group">
        <h3>Archives</h3>
        <a href="https://trustjonathan.github.io/BIOLOGY/archive.html">Biology archive</a>
        <a href="https://trustjonathan.github.io/CHEMISTRY/archive.html">Chemistry archive</a>
        <a href="https://trustjonathan.github.io/MATHEMATICS/archive.html">Mathematics archive</a>
      </div>
      <div class="footer-brand">
        <a class="brand" href={base}>
          <img src={`${base}logo.png`} width="32" height="32" alt="" />
          <span>Study Hub / Chemistry</span>
        </a>
        <p>Free Chemistry study resources for focused revision.</p>
        <a class="back-to-top" href="#top">Back to top <span aria-hidden="true">↑</span></a>
      </div>
    </footer>
  </body>
</html>
